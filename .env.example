# ==============================================================================
# LogisticsEdge Platform — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or production credentials to source control.
# ==============================================================================

# Public Application URL (sitemaps, OpenGraph, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://logisticsedge.io

# ── SECURITY (REQUIRED IN PRODUCTION) ─────────────────────────────────────────
# Session signing secret — must be a random string of 32+ characters.
# Generate with: openssl rand -base64 32
# If missing, sessions fall back to an insecure dev default (logged as error).
AUTH_SECRET=replace-this-with-a-random-32-char-secret-string

# ── DATABASE ──────────────────────────────────────────────────────────────────
# PostgreSQL / Supabase / Neon connection string (server-side only)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/logistics_db

# ── EXTERNAL SERVICES ─────────────────────────────────────────────────────────
# Telematics & Dispatch Gateway token (server-side only — never expose to client)
# TELEMATICS_API_SECRET=your-secure-telematics-secret-token-here

# SMS / Notification Webhook (server-side only)
# SMS_GATEWAY_API_KEY=your-sms-gateway-key-here

# ── WEBSITE ANALYTICS (optional, consent-gated) ───────────────────────────────
# Each tool loads only if its ID is set AND the visitor accepts analytics in the cookie notice.
# The CSP in src/proxy.ts allows a tool's script host only when its ID is set. See src/lib/analytics.ts.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── WHATSAPP CLICK-TO-CHAT (optional) ─────────────────────────────────────────
# Business WhatsApp number, international form, digits only (e.g. 919876543210).
# Unset: WhatsApp buttons on the website stay hidden. See src/lib/whatsapp.ts.
# NEXT_PUBLIC_WHATSAPP_NUMBER=
